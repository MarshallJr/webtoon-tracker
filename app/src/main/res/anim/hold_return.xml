<?xml version="1.0" encoding="utf-8"?>
<!-- L'écran du dessous revient en place quand on ferme la fiche. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="260"
    android:interpolator="@interpolator/emphasized">
    <scale android:fromXScale="0.97" android:fromYScale="0.97" android:toXScale="1" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="0.6" android:toAlpha="1" />
</set>
