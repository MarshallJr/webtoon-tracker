<?xml version="1.0" encoding="utf-8"?>
<!-- Ouverture de la fiche : elle monte un peu en grandissant et en apparaissant. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@interpolator/emphasized"
    android:shareInterpolator="true"
    android:zAdjustment="top">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="200" />
    <scale android:fromXScale="0.94" android:fromYScale="0.94" android:toXScale="1" android:toYScale="1"
        android:pivotX="50%" android:pivotY="60%" />
    <translate android:fromYDelta="4%" android:toYDelta="0" />
</set>
