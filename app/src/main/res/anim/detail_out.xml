<?xml version="1.0" encoding="utf-8"?>
<!-- Fermeture de la fiche : elle redescend légèrement en s'effaçant. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:interpolator="@android:interpolator/fast_out_linear_in"
    android:shareInterpolator="true"
    android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale android:fromXScale="1" android:fromYScale="1" android:toXScale="0.95" android:toYScale="0.95"
        android:pivotX="50%" android:pivotY="60%" />
    <translate android:fromYDelta="0" android:toYDelta="3%" />
</set>
