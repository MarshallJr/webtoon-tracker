<?xml version="1.0" encoding="utf-8"?>
<!-- Surface opaque, coins 28 dp, liseré clair, léger reflet violet en haut à gauche -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="315" android:startColor="#FF251E42" android:endColor="#FF14111F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
