<?xml version="1.0" encoding="utf-8"?>
<!-- Bannière : carte opaque violet nuit, coins 22 dp, liseré clair (lisible sur n'importe quelle page) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="315" android:startColor="#FF262039" android:endColor="#FF17141F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
