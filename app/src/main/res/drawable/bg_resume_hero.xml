<?xml version="1.0" encoding="utf-8"?>
<!-- Carte « Reprendre » : verre nuit, reflet violet à gauche, liseré violet lumineux -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="0" android:startColor="#FF1C1533" android:centerColor="#FF13101F" android:endColor="#FF110E1C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:type="radial" android:centerX="0.12" android:centerY="0.5"
                android:gradientRadius="160dp" android:startColor="#388B5CF6" android:endColor="#008B5CF6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1.2dp" android:color="#7A8B5CF6" />
        </shape>
    </item>
</layer-list>
