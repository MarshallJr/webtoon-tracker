<?xml version="1.0" encoding="utf-8"?>
<!-- Bandeau fort (Activité) : violet profond, lueur magenta -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="315" android:startColor="#FF7C3AED" android:centerColor="#FF4C1D95" android:endColor="#FF1E1046" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:type="radial" android:centerX="0.95" android:centerY="0.05"
                android:gradientRadius="240dp" android:startColor="#66E879F9" android:endColor="#00E879F9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
