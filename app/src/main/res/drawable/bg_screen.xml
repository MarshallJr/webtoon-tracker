<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de l'appli : noir profond, halo violet en haut, lueur plus sombre en bas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/screen_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.92" android:centerY="0.0"
                android:gradientRadius="440dp" android:startColor="#3D7C3AED" android:centerColor="#147C3AED"
                android:endColor="#007C3AED" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.0" android:centerY="1.0"
                android:gradientRadius="380dp" android:startColor="#296D28D9" android:endColor="#006D28D9" />
        </shape>
    </item>
</layer-list>
