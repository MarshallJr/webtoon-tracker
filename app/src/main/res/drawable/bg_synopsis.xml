<?xml version="1.0" encoding="utf-8"?>
<!-- Carte du résumé : verre violet sombre, liseré lumineux -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="315" android:startColor="#E6241A4A" android:centerColor="#E6150F2A"
                android:endColor="#E60F0B1D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1.2dp" android:color="#998B7CF6" />
        </shape>
    </item>
</layer-list>
