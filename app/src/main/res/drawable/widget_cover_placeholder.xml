<?xml version="1.0" encoding="utf-8"?>
<!-- Couverture d'attente (aperçu du widget) : 2:3, coins arrondis, logo au centre -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="72dp" android:height="108dp" />
            <corners android:radius="12dp" />
            <gradient android:angle="270" android:startColor="#FF4A3A8C" android:endColor="#FF231A45" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_logo" android:gravity="center" android:width="44dp" android:height="48dp" />
</layer-list>
