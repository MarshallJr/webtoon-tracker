<?xml version="1.0" encoding="utf-8"?>
<!-- Fondu d'une tuile : transparent en haut, nuit profonde sous le titre (mêmes coins que la couverture) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#00000000" android:centerColor="#000E0C17"
                android:centerY="0.4" android:endColor="#F00E0C17" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#00000000" android:centerColor="#000E0C17"
                android:centerY="0.65" android:endColor="#990E0C17" />
        </shape>
    </item>
</layer-list>
