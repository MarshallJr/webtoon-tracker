<?xml version="1.0" encoding="utf-8"?>
<!-- Carte en verre cliquable (même rendu que bg_card) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#24A78BFA">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient android:angle="315" android:startColor="#FF17122A" android:centerColor="#FF110E1C"
                        android:endColor="#FF0E0C17" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <stroke android:width="1dp" android:color="#4D8B7CF6" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
