<?xml version="1.0" encoding="utf-8"?>
<!-- Fondu d'une carte immersive : l'image reste nette en haut puis plonge dans le noir sous le texte -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient android:angle="270" android:startColor="#00000000" android:centerColor="#000E0C17"
                android:centerY="0.38" android:endColor="#F20E0C17" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient android:angle="270" android:startColor="#00000000" android:centerColor="#000E0C17"
                android:centerY="0.6" android:endColor="#CC0E0C17" />
        </shape>
    </item>
</layer-list>
