<?xml version="1.0" encoding="utf-8"?>
<!-- Fondu du bandeau d'une fiche : voile violet, gauche assombrie (couverture et titre lisibles),
     léger voile en haut (boutons), puis fondu progressif jusqu'au fond, sans marche visible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E3B1A86" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#B307060B" android:centerColor="#4007060B"
                android:centerX="0.45" android:endColor="#0007060B" />
        </shape>
    </item>
    <item android:bottom="200dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#59000000" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:top="110dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#00000000" android:centerColor="@color/screen_bg_half"
                android:centerY="0.55" android:endColor="@color/screen_bg" />
        </shape>
    </item>
</layer-list>
