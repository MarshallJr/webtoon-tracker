<?xml version="1.0" encoding="utf-8"?>
<!-- Carte en verre nuit : reflet violet en haut à gauche, liseré violet -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="315" android:startColor="#FF17122A" android:centerColor="#FF110E1C"
                android:endColor="#FF0E0C17" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#4D8B7CF6" />
        </shape>
    </item>
</layer-list>
