<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton lecture rond : violet lumineux, liseré clair -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="315" android:startColor="#FFB197FC" android:centerColor="#FF8B5CF6"
                        android:endColor="#FF6D28D9" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="1.5dp" android:color="#66EDE9FE" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
