<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:clipChildren="false">

    <!-- Les pages défilent sous la barre en verre (vues floutées à travers elle) -->
    <com.lois.webtoontracker.GlassSource
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ═════════════════════ ACCUEIL ═════════════════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/nav_space">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- En-tête -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Logo"
                        android:src="@drawable/ic_logo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_soft"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="-0.02"
                            android:text="Webtoon Tracker"
                            android:textColor="@color/text_main"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/settingsButton"
                        style="@style/HeaderIcon"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:contentDescription="Réglages"
                        android:src="@drawable/ic_settings" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/bg_dot"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />

                <!-- Recherche (ouvre la bibliothèque) -->
                <LinearLayout
                    android:id="@+id/homeSearch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/shadow"
                    android:outlineSpotShadowColor="@color/shadow"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        android:tint="@color/text_soft" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Rechercher une série"
                        android:textColor="@color/text_soft"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/hairline" />

                    <ImageView
                        android:id="@+id/homeFilter"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Filtres"
                        android:padding="11dp"
                        android:src="@drawable/ic_tune"
                        android:tint="@color/text_main" />
                </LinearLayout>

                <!-- Reprendre la lecture -->
                <TextView
                    android:id="@+id/resumeSection"
                    style="@style/SectionTitle"
                    android:layout_marginTop="22dp"
                    android:text="Reprendre la lecture"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/resumeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_resume_hero"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/shadow_strong"
                    android:outlineSpotShadowColor="@color/shadow_strong"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="178dp"
                        android:layout_gravity="center_vertical">

                        <TextView
                            android:id="@+id/resumeLetter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="40sp" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/resumeCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/RoundedCover" />
                    </FrameLayout>

                    <!-- Hauteur = son contenu (au moins celle de la couverture) : le bouton n'est jamais coupé -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:minHeight="178dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/resumeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="-0.01"
                            android:maxLines="2"
                            android:textColor="@color/text_main"
                            android:textSize="19sp" />

                        <!-- « FR · WEBTOON » (ou le site) + « ★ 7,4 » sur une ligne -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/resumeSource"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_tag_small"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:textColor="@color/badge_text"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/resumeRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:maxLines="1"
                                android:textColor="@color/accent"
                                android:textSize="14sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/resumeLast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:maxLines="2"
                            android:textColor="@color/text_soft"
                            android:textSize="13sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/resumeProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="1000"
                            android:visibility="gone"
                            app:indicatorColor="@color/brand"
                            app:trackColor="@color/badge_bg"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="6dp" />

                        <!-- Garde « il y a 15 min » pour le code, fondu dans la ligne du dessus -->
                        <TextView
                            android:id="@+id/resumeWhen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <!-- Remplit l'espace libre : le bouton reste en bas de la carte -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:minHeight="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/resumeButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:fontFamily="sans-serif-medium"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Reprendre"
                            android:textColor="@color/on_accent"
                            android:textSize="16sp"
                            app:backgroundTint="@color/accent"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconTint="@color/on_accent" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Nouveautés -->
                <LinearLayout
                    android:id="@+id/updatesCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_stroke"
                    android:clickable="true"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/shadow"
                    android:outlineSpotShadowColor="@color/shadow"
                    android:padding="12dp"
                    android:visibility="gone">

                    <!-- Couvertures empilées des séries mises à jour (remplies dans le code) -->
                    <FrameLayout
                        android:id="@+id/updatesCovers"
                        android:layout_width="68dp"
                        android:layout_height="46dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/updatesTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_main"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/updatesSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/text_soft"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/updatesCount"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_count"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/text_soft" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dupCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/badge_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/dupText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/badge_text"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dupButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fusionner" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cette semaine -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Cette semaine"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/homeStatsLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_outward"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/brand"
                        android:fontFamily="sans-serif-medium"
                        android:padding="6dp"
                        android:text="Stats"
                        android:textColor="@color/brand"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statSeries"
                            style="@style/HomeStatNumber" />

                        <TextView
                            style="@style/HomeStatLabel"
                            android:text="séries" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="16dp"
                        android:background="@color/hairline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statChapters"
                            style="@style/HomeStatNumber" />

                        <TextView
                            style="@style/HomeStatLabel"
                            android:text="chapitres lus" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="16dp"
                        android:background="@color/hairline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statWeek"
                            style="@style/HomeStatNumber" />

                        <TextView
                            style="@style/HomeStatLabel"
                            android:text="cette semaine" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Lectures récentes -->
                <LinearLayout
                    android:id="@+id/homeRecentHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Lectures récentes"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/homeSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawableTint="@color/brand"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:padding="6dp"
                        android:text="Tout voir"
                        android:textColor="@color/brand"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="-4dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <!-- Vide -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="130dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_logo" />

                    <TextView
                        android:id="@+id/emptyTitle"
                        style="@style/SectionTitle"
                        android:layout_marginTop="14dp"
                        android:text="Aucune lecture pour l'instant" />

                    <TextView
                        android:id="@+id/emptyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="Lis un chapitre dans WEBTOON, Mihon ou ton navigateur pendant quelques secondes : il apparaîtra ici automatiquement."
                        android:textColor="@color/text_soft"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/emptyRestoreButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Restaurer une sauvegarde" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═════════════════════ BIBLIOTHÈQUE ═════════════════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageLibrary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/nav_space"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Logo"
                        android:src="@drawable/ic_logo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="Webtoon Tracker"
                        android:textColor="@color/text_main"
                        android:textSize="20sp" />

                    <ImageButton
                        android:id="@+id/libSearchButton"
                        style="@style/HeaderIcon"
                        android:contentDescription="Rechercher"
                        android:src="@drawable/ic_search" />

                    <ImageButton
                        android:id="@+id/libAddIcon"
                        style="@style/HeaderIcon"
                        android:contentDescription="Ajouter"
                        android:src="@drawable/ic_add" />
                </LinearLayout>

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_search"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/text_soft"
                    android:hint="Rechercher une série"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_soft"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sectionTitle"
                            style="@style/SectionTitle"
                            android:text="Ma bibliothèque"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/libCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_soft"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Ajouter"
                        app:cornerRadius="999dp"
                        app:icon="@drawable/ic_add"
                        app:iconSize="18dp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/tagScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="-20dp"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/tagChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="26dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:background="@color/hairline" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/filterChip"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Filtres"
                            android:textColor="@color/text_main"
                            app:chipBackgroundColor="@color/card_bg"
                            app:chipCornerRadius="999dp"
                            app:chipIcon="@drawable/ic_tune"
                            app:chipIconSize="18dp"
                            app:chipIconTint="@color/text_main"
                            app:chipStrokeColor="@color/hairline"
                            app:chipStrokeWidth="1dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/seriesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="-4dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <TextView
                    android:id="@+id/libEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="Aucune série ne correspond."
                    android:textColor="@color/text_soft"
                    android:visibility="gone" />

                <!-- Rythme de lecture -->
                <LinearLayout
                    android:id="@+id/libRhythm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_stroke"
                    android:clickable="true"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/shadow"
                    android:outlineSpotShadowColor="@color/shadow"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icon_box">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_library"
                            android:tint="@color/badge_text" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Ton rythme de lecture"
                            android:textColor="@color/text_main"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/libRhythmSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_soft"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            android:drawableTint="@color/brand"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:text="Voir mon activité"
                            android:textColor="@color/brand"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═════════════════════ ACTIVITÉ ═════════════════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageActivity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/nav_space"
            android:visibility="gone">

            <include
                android:id="@+id/activityContent"
                layout="@layout/stats_content" />
        </androidx.core.widget.NestedScrollView>
    </com.lois.webtoontracker.GlassSource>

    <!-- ═════════════════════ NAVIGATION ═════════════════════ -->
    <com.lois.webtoontracker.GlassBar
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/NavItem">

            <FrameLayout
                android:id="@+id/navHomePill"
                style="@style/NavPill">

                <ImageView
                    android:id="@+id/navHomeIcon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_home" />
            </FrameLayout>

            <TextView
                android:id="@+id/navHomeLabel"
                style="@style/NavLabel"
                android:text="Accueil" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLibrary"
            style="@style/NavItem">

            <FrameLayout
                android:id="@+id/navLibraryPill"
                style="@style/NavPill">

                <ImageView
                    android:id="@+id/navLibraryIcon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_library" />
            </FrameLayout>

            <TextView
                android:id="@+id/navLibraryLabel"
                style="@style/NavLabel"
                android:text="Bibliothèque" />
        </LinearLayout>

        <!-- Logo animé (éclairs) : reprendre la lecture -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="58dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/navLogo"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center"
                android:contentDescription="Reprendre la lecture"
                android:elevation="10dp"
                android:outlineAmbientShadowColor="@color/logo_glow"
                android:outlineSpotShadowColor="@color/logo_glow"
                android:padding="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_glow"
                android:translationY="-10dp"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/logo_ring"
                app:strokeWidth="2dp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navUpdates"
            style="@style/NavItem">

            <FrameLayout
                android:id="@+id/navUpdatesPill"
                style="@style/NavPill">

                <ImageView
                    android:id="@+id/navUpdatesIcon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_bell" />

                <TextView
                    android:id="@+id/navUpdatesBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_nav_badge"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:minWidth="16dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/on_accent"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/navUpdatesLabel"
                style="@style/NavLabel"
                android:text="Nouveautés" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navActivity"
            style="@style/NavItem">

            <FrameLayout
                android:id="@+id/navActivityPill"
                style="@style/NavPill">

                <ImageView
                    android:id="@+id/navActivityIcon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_activity" />
            </FrameLayout>

            <TextView
                android:id="@+id/navActivityLabel"
                style="@style/NavLabel"
                android:text="Activité" />
        </LinearLayout>
    </com.lois.webtoontracker.GlassBar>
</FrameLayout>
