<?xml version="1.0" encoding="utf-8"?>
<!-- En-tête de « Découvrir » : titre, recherche, Ma liste à lire, Pour toi, tri et filtres -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="14dp"
    android:paddingEnd="6dp">

    <TextView
        style="@style/PageTitle"
        android:text="Découvrir" />

    <TextView
        android:id="@+id/dqSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Des séries très bien notées que tu n'as pas encore lues"
        android:textColor="@color/text_soft"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/dqSearchBox"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/shadow"
        android:outlineSpotShadowColor="@color/shadow"
        android:paddingStart="18dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="@color/text_soft" />

        <EditText
            android:id="@+id/dqSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Rechercher un titre…"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_faint"
            android:textSize="15.5sp" />

        <ImageButton
            android:id="@+id/dqClear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Effacer la recherche"
            android:src="@drawable/ic_close"
            android:tint="@color/text_soft"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Ma liste à lire -->
    <LinearLayout
        android:id="@+id/dqWishSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            style="@style/SectionHeader"
            android:layout_marginTop="24dp">

            <ImageView
                style="@style/SectionIcon"
                android:src="@drawable/ic_bookmark" />

            <TextView
                android:id="@+id/dqWishTitle"
                style="@style/SectionTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Ma liste à lire" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dqWishList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_bleed_neg"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/header_bleed_neg"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/header_bleed"
            android:paddingEnd="@dimen/header_bleed" />
    </LinearLayout>

    <!-- Pour toi -->
    <LinearLayout
        style="@style/SectionHeader"
        android:layout_marginTop="24dp">

        <ImageView
            style="@style/SectionBadge"
            android:src="@drawable/ic_sparkle_grad" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Pour toi" />

        <TextView
            android:id="@+id/dqForYouRefresh"
            style="@style/SectionLink"
            android:drawableEnd="@null"
            android:drawableStart="@drawable/ic_refresh"
            android:text="Actualiser" />
    </LinearLayout>

    <TextView
        android:id="@+id/dqForYouSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_soft"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:minHeight="80dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dqForYou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_bleed_neg"
            android:layout_marginEnd="@dimen/header_bleed_neg"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/header_bleed"
            android:paddingEnd="@dimen/header_bleed" />

        <ProgressBar
            android:id="@+id/dqForYouLoading"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_bright"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dqForYouEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="@color/text_soft"
            android:textSize="13.5sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Explorer : tri et filtres -->
    <LinearLayout
        style="@style/SectionHeader"
        android:layout_marginTop="26dp">

        <ImageView
            style="@style/SectionBadge"
            android:src="@drawable/ic_compass_badge" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Explorer" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_bleed_neg"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/header_bleed_neg"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/header_bleed"
        android:paddingEnd="@dimen/header_bleed"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/dqSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dqFilters"
            style="@style/WT.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:fontFamily="@font/inter_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="Filtres"
            android:textColor="@color/text_main"
            android:textSize="13.5sp"
            app:backgroundTint="@color/card_raised"
            app:cornerRadius="21dp"
            app:icon="@drawable/ic_tune"
            app:iconSize="18dp"
            app:iconTint="@color/primary_bright"
            app:strokeColor="@color/stroke_glass"
            app:strokeWidth="1dp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/dqActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/dqInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/text_soft"
        android:textSize="12.5sp" />
</LinearLayout>
