<?xml version="1.0" encoding="utf-8"?>
<!-- En-tête de « Découvrir » : titre, recherche, Ma liste à lire, Pour toi, tri et filtres -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:text="Découvrir"
        android:textColor="@color/text_main"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/dqSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Des séries très bien notées que tu n'as pas encore lues"
        android:textColor="@color/text_soft"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/dqSearchBox"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="@color/text_soft" />

        <EditText
            android:id="@+id/dqSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Rechercher un titre"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_soft"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/dqClear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Effacer la recherche"
            android:src="@drawable/ic_close"
            android:tint="@color/text_soft"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Ma liste à lire -->
    <LinearLayout
        android:id="@+id/dqWishSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/dqWishTitle"
            style="@style/DiscoverSection"
            android:layout_marginTop="24dp"
            android:text="Ma liste à lire" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dqWishList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="-20dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

    <!-- Pour toi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/DiscoverSection"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Pour toi" />

        <TextView
            android:id="@+id/dqForYouRefresh"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_refresh"
            android:drawablePadding="6dp"
            android:drawableTint="@color/brand"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Actualiser"
            android:textColor="@color/brand"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/dqForYouSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_soft"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="80dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dqForYou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-20dp"
            android:layout_marginEnd="-20dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <ProgressBar
            android:id="@+id/dqForYouLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dqForYouEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="@color/text_soft"
            android:textSize="13.5sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Explorer : tri et filtres -->
    <TextView
        style="@style/DiscoverSection"
        android:layout_marginTop="26dp"
        android:text="Explorer" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="-20dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/dqSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dqFilters"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="Filtres"
            android:textColor="@color/badge_text"
            android:textSize="14sp"
            app:backgroundTint="@color/badge_bg"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_tune"
            app:iconSize="18dp"
            app:iconTint="@color/badge_text" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/dqActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/dqInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:textColor="@color/text_soft"
        android:textSize="12.5sp" />
</LinearLayout>
