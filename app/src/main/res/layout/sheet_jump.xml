<?xml version="1.0" encoding="utf-8"?>
<!-- Feuille « Aller à l'épisode » : numéro, tranches, aller, marquer 1 → N comme lus -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_handle" />

    <TextView
        android:id="@+id/jTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Aller à l'épisode"
        android:textColor="@color/text_main"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/jSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_soft"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/jField"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_jump_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/jUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Épisode"
            android:textColor="@color/text_soft"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/jInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="sans-serif-black"
            android:hint="18"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLength="7"
            android:singleLine="true"
            android:textColor="@color/text_main"
            android:textColorHint="@color/hairline_strong"
            android:textSize="28sp" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/jRanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="false"
        app:singleSelection="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/jGo"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Aller à l'épisode"
        android:textColor="@color/on_accent"
        android:textSize="16sp"
        app:backgroundTint="@color/accent"
        app:cornerRadius="27dp"
        app:icon="@drawable/ic_jump"
        app:iconGravity="textStart"
        app:iconTint="@color/on_accent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/jMark"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textColor="@color/badge_text"
        android:textSize="14.5sp"
        android:visibility="gone"
        app:cornerRadius="25dp"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:iconSize="18dp"
        app:iconTint="@color/badge_text"
        app:strokeColor="@color/hairline_strong" />
</LinearLayout>
