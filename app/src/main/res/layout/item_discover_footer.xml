<?xml version="1.0" encoding="utf-8"?>
<!-- Bas de la grille : chargement, fin des résultats ou erreur (avec « Réessayer ») -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:padding="16dp">

    <ProgressBar
        android:id="@+id/dfLoading"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:indeterminateTint="@color/brand" />

    <TextView
        android:id="@+id/dfText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_soft"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dfRetry"
        style="@style/WT.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="Réessayer"
        android:textColor="@color/brand"
        android:visibility="gone" />
</LinearLayout>
