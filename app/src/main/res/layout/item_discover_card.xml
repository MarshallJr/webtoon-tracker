<?xml version="1.0" encoding="utf-8"?>
<!-- Carte immersive (Pour toi, Ma liste à lire) : couverture, note, signet, titre, type · année, genre -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_cover_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/fg_card_ripple"
    android:orientation="vertical"
    android:padding="1dp">

    <com.lois.webtoontracker.RatioFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/dcCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedTop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_card_scrim"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/dcScore"
            style="@style/ScorePill"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dcWish"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_bookmark_btn"
            android:contentDescription="Ma liste à lire"
            android:padding="6dp"
            android:src="@drawable/ic_bookmark_border"
            android:tint="#FFFFFF" />
    </com.lois.webtoontracker.RatioFrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="9dp"
        android:paddingEnd="11dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/dcTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_bold"
            android:maxLines="1"
            android:textColor="@color/text_main"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/dcMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dcGenre"
            style="@style/GenreTag"
            android:layout_marginTop="9dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
