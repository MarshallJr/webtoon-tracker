<?xml version="1.0" encoding="utf-8"?>
<!-- Carte immersive (Pour toi, Ma liste à lire) : la couverture remplit la carte et se fond dans le noir ;
     note en haut, signet, titre, type · année et genre posés sur le fondu -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/card_width"
    android:layout_height="@dimen/card_height"
    android:layout_marginEnd="11dp"
    android:background="@drawable/bg_cover_card"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="true"
    android:foreground="@drawable/fg_card_ripple"
    android:outlineAmbientShadowColor="@color/shadow"
    android:outlineSpotShadowColor="@color/shadow">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/dcCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedCardInner" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/bg_card_fade"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/dcScore"
        style="@style/ScorePill"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/dcWish"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end"
            android:layout_marginBottom="2dp"
            android:contentDescription="Ma liste à lire"
            android:padding="4dp"
            android:src="@drawable/ic_bookmark_border"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/dcTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dcMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#B8B3CC"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/dcGenre"
            style="@style/GenreTag"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
