<?xml version="1.0" encoding="utf-8"?>
<!-- Page Activité (statistiques), incluse dans l'accueil -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_padding"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/page_padding"
    android:paddingBottom="24dp">

    <TextView
        style="@style/PageTitle"
        android:text="Activité" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Ton rythme de lecture, en un coup d'œil"
        android:textColor="@color/text_soft"
        android:textSize="14sp" />

    <!-- Bandeau : temps de lecture estimé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_hero"
        android:elevation="14dp"
        android:orientation="vertical"
        android:outlineAmbientShadowColor="@color/shadow_strong"
        android:outlineSpotShadowColor="@color/shadow_strong"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:text="Temps de lecture estimé"
            android:textColor="#D9FFFFFF"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/sTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_display_extrabold"
            android:fontFeatureSettings="tnum"
            android:letterSpacing="-0.02"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/sTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF"
            android:textSize="13.5sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="#2EFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/aWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_display_extrabold"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="chapitres cette semaine"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/aTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:fontFamily="@font/inter_semibold"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quatre tuiles : série en cours, record, jour et moment préférés -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-5dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="-5dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout style="@style/StatTile">

            <ImageView
                style="@style/StatTileIcon"
                android:src="@drawable/ic_fire"
                android:tint="#FB7A45" />

            <TextView
                android:id="@+id/sStreak"
                style="@style/StatTileValue" />

            <TextView
                style="@style/StatTileLabel"
                android:text="jours d'affilée" />

            <TextView
                android:id="@+id/sStreakSub"
                style="@style/StatTileSub" />
        </LinearLayout>

        <LinearLayout style="@style/StatTile">

            <ImageView
                style="@style/StatTileIcon"
                android:src="@drawable/ic_trophy"
                android:tint="@color/star" />

            <TextView
                android:id="@+id/sRecord"
                style="@style/StatTileValue" />

            <TextView
                style="@style/StatTileLabel"
                android:text="record en un jour" />

            <TextView
                android:id="@+id/sRecordSub"
                style="@style/StatTileSub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-5dp"
        android:layout_marginEnd="-5dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout style="@style/StatTile">

            <ImageView
                style="@style/StatTileIcon"
                android:src="@drawable/ic_calendar"
                android:tint="#7DA7FF" />

            <TextView
                android:id="@+id/sDay"
                style="@style/StatTileValue" />

            <TextView
                style="@style/StatTileLabel"
                android:text="jour préféré" />

            <TextView
                android:id="@+id/sDaySub"
                style="@style/StatTileSub" />
        </LinearLayout>

        <LinearLayout style="@style/StatTile">

            <ImageView
                style="@style/StatTileIcon"
                android:src="@drawable/ic_clock"
                android:tint="@color/primary_bright" />

            <TextView
                android:id="@+id/sSlot"
                style="@style/StatTileValue" />

            <TextView
                style="@style/StatTileLabel"
                android:text="moment préféré" />

            <TextView
                android:id="@+id/sSlotSub"
                style="@style/StatTileSub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/DetailCard">

        <TextView
            style="@style/CardTitle"
            android:text="14 derniers jours" />

        <com.lois.webtoontracker.BarChartView
            android:id="@+id/chart14"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="14dp" />
    </LinearLayout>

    <LinearLayout style="@style/DetailCard">

        <TextView
            style="@style/CardTitle"
            android:text="Par jour de la semaine" />

        <com.lois.webtoontracker.BarChartView
            android:id="@+id/chartWeek"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="14dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aGenresCard"
        style="@style/DetailCard">

        <TextView
            style="@style/CardTitle"
            android:text="Genres préférés" />

        <LinearLayout
            android:id="@+id/aGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout style="@style/DetailCard">

        <TextView
            style="@style/CardTitle"
            android:text="Tes séries les plus lues" />

        <LinearLayout
            android:id="@+id/topList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout style="@style/DetailCard">

        <TextView
            style="@style/CardTitle"
            android:text="Activité récente" />

        <LinearLayout
            android:id="@+id/aRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Temps estimé sur une base de ~5 min par chapitre"
        android:textColor="@color/text_faint"
        android:textSize="11.5sp" />
</LinearLayout>
