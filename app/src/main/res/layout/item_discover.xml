<?xml version="1.0" encoding="utf-8"?>
<!-- Tuile immersive (Explorer, grille Découvrir) : couverture pleine, note, titre et type posés sur un fondu -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:padding="5dp">

    <com.lois.webtoontracker.RatioFrameLayout
        android:id="@+id/dcFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tile"
        android:elevation="4dp"
        android:foreground="@drawable/fg_tile_ripple"
        android:outlineAmbientShadowColor="@color/shadow"
        android:outlineSpotShadowColor="@color/shadow">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/dcCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedTile" />

        <!-- Fondu du bas : le titre reste lisible sur toutes les couvertures -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:background="@drawable/bg_tile_scrim"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/dcScore"
            style="@style/ScorePill"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dcWish"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_bookmark_btn"
            android:contentDescription="Ma liste à lire"
            android:padding="5dp"
            android:src="@drawable/ic_bookmark_border"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingEnd="8dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/dcTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:lineSpacingExtra="-1dp"
                android:maxLines="2"
                android:shadowColor="#99000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/dcMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="#B8B3CC"
                android:textSize="11sp" />
        </LinearLayout>
    </com.lois.webtoontracker.RatioFrameLayout>
</FrameLayout>
