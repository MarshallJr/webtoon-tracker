<?xml version="1.0" encoding="utf-8"?>
<!-- Tuile immersive (grille Découvrir, Explorer) : couverture pleine, note, titre et type posés sur un voile -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:padding="5dp">

    <com.lois.webtoontracker.RatioFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/fg_tile_ripple">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/dcCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedGrid" />

        <!-- Voile du bas : le titre reste lisible sur toutes les couvertures -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tile_scrim"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tile_stroke"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/dcScore"
            style="@style/ScorePill"
            android:layout_gravity="top|start"
            android:layout_margin="7dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dcWish"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_bookmark_btn"
            android:contentDescription="Ma liste à lire"
            android:padding="6dp"
            android:src="@drawable/ic_bookmark_border"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/dcTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:lineSpacingExtra="-1dp"
                android:maxLines="2"
                android:shadowColor="#99000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/dcMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="11.5sp" />
        </LinearLayout>
    </com.lois.webtoontracker.RatioFrameLayout>
</FrameLayout>
