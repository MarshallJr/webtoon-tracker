<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- ───────── Hero : la couverture en grand ───────── -->
            <FrameLayout
                android:id="@+id/dHero"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@color/screen_bg"
                android:clipChildren="true">

                <ImageView
                    android:id="@+id/dHeaderBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/brand_dark"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:id="@+id/dHeaderFade"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_detail_fade" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/dContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-170dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="110dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="132dp"
                        android:layout_height="196dp"
                        android:background="@drawable/bg_card"
                        android:elevation="16dp"
                        android:outlineAmbientShadowColor="@color/shadow_strong"
                        android:outlineSpotShadowColor="@color/shadow_strong">

                        <TextView
                            android:id="@+id/dAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="48sp" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/dCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/RoundedCover" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/dFormat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_soft"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.08"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:textColor="@color/badge_text"
                                android:textSize="11sp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/dYear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="@color/text_soft"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_main"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/dTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="-0.02"
                            android:maxLines="4"
                            android:textColor="@color/text_main"
                            android:textSize="24sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/dTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:chipSpacingVertical="0dp" />

                <!-- Bibliothèque | Alertes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_check"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/text_main"
                        android:gravity="center_vertical"
                        android:text="Dans ma bibliothèque"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/hairline" />

                    <LinearLayout
                        android:id="@+id/dBellRow"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:id="@+id/dBellIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bell" />

                        <TextView
                            android:id="@+id/dBellLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Alertes"
                            android:textColor="@color/text_main"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dResume"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:outlineAmbientShadowColor="#99FFB020"
                    android:outlineSpotShadowColor="#99FFB020"
                    android:text="Reprendre la lecture"
                    android:textColor="@color/on_accent"
                    android:textSize="16sp"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="18dp"
                    app:elevation="6dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconTint="@color/on_accent" />

                <TextView
                    android:id="@+id/dResumeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/dTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="-20dp"
                    android:background="@android:color/transparent"
                    app:tabIndicatorColor="@color/brand"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="3dp"
                    app:tabRippleColor="@null"
                    app:tabSelectedTextColor="@color/brand"
                    app:tabTextAppearance="@style/TabText"
                    app:tabTextColor="@color/text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="-20dp"
                    android:layout_marginEnd="-20dp"
                    android:background="@color/hairline" />

                <!-- ═════════ Onglet : Aperçu ═════════ -->
                <LinearLayout
                    android:id="@+id/tabOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/dWhereCard"
                        style="@style/DetailCard"
                        android:visibility="gone">

                        <TextView
                            style="@style/CardTitle"
                            android:text="🔔 Où lire la suite" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/dWhere"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout style="@style/DetailCard">

                        <TextView
                            style="@style/CardTitle"
                            android:text="Synopsis"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/dSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="3dp"
                            android:maxLines="5"
                            android:text="Chargement du résumé…"
                            android:textColor="@color/text_main"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/dSummaryMore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            android:drawableTint="@color/brand"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:text="Lire la suite"
                            android:textColor="@color/brand"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/dSummarySrc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_soft"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dRecoTitle"
                        style="@style/SectionTitle"
                        android:layout_marginTop="22dp"
                        android:text="Dans le même univers"
                        android:textSize="18sp"
                        android:visibility="gone" />

                    <HorizontalScrollView
                        android:id="@+id/dRecoScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-20dp"
                        android:layout_marginEnd="-20dp"
                        android:clipToPadding="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/dRecos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- ═════════ Onglet : Épisodes ═════════ -->
                <LinearLayout
                    android:id="@+id/tabEpisodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- « J'avais lu les premiers chapitres avant l'appli » -->
                    <LinearLayout
                        android:id="@+id/eBackfill"
                        style="@style/DetailCard"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/eBackfillText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_main"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/eBackfillBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:padding="8dp"
                            android:text="Marquer"
                            android:textColor="@color/brand"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/eBackfillClose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="✕"
                            android:textColor="@color/text_soft"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/eCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_main"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/eAdd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:padding="6dp"
                            android:text="＋ Ajouter"
                            android:textColor="@color/brand"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/eSort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:drawableEnd="@drawable/ic_sort"
                            android:drawablePadding="2dp"
                            android:drawableTint="@color/text_soft"
                            android:gravity="center_vertical"
                            android:padding="6dp"
                            android:textColor="@color/text_soft"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/eList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-20dp"
                        android:layout_marginEnd="-20dp"
                        android:animateLayoutChanges="false"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/eMore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:padding="14dp"
                        android:textColor="@color/brand"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/eHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Appui long sur un épisode pour le marquer lu / non lu"
                        android:textColor="@color/text_soft"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ═════════ Onglet : Mon suivi ═════════ -->
                <LinearLayout
                    android:id="@+id/tabTracking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginTop="18dp"
                        android:text="Ton aventure"
                        android:textSize="22sp" />

                    <LinearLayout style="@style/DetailCard">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_icon_box">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_library"
                                    android:tint="@color/badge_text" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Dernier chapitre lu"
                                    android:textColor="@color/text_soft"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/dTrackLast"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:textColor="@color/text_main"
                                    android:textSize="24sp" />

                                <TextView
                                    android:id="@+id/dTrackWhen"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_soft"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View style="@style/Divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/dTrackCount"
                                    style="@style/TrackNumber" />

                                <TextView
                                    android:id="@+id/dTrackCountLabel"
                                    style="@style/HomeStatLabel" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="16dp"
                                android:background="@color/hairline" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/dTrackTime"
                                    style="@style/TrackNumber" />

                                <TextView
                                    style="@style/HomeStatLabel"
                                    android:text="de lecture" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="16dp"
                                android:background="@color/hairline" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/dTrackPace"
                                    style="@style/TrackNumber" />

                                <TextView
                                    style="@style/HomeStatLabel"
                                    android:text="par semaine" />
                            </LinearLayout>
                        </LinearLayout>

                        <View style="@style/Divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar"
                                android:tint="@color/text_soft" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Première lecture"
                                    android:textColor="@color/text_soft"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/dTrackFirst"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/text_main"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Progression -->
                    <LinearLayout style="@style/DetailCard">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/CardTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="Progression" />

                            <TextView
                                android:id="@+id/dProgValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/text_main"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/dProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:max="1000"
                            app:indicatorColor="@color/accent"
                            app:trackColor="@color/chart_grid"
                            app:trackCornerRadius="99dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:id="@+id/dProgSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_soft"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Mon avis -->
                    <LinearLayout style="@style/DetailCard">

                        <TextView
                            style="@style/CardTitle"
                            android:text="Mon avis"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Ta note"
                            android:textColor="@color/text_soft"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/dStars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal" />

                        <EditText
                            android:id="@+id/dNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_search"
                            android:gravity="top"
                            android:hint="Ajouter une note personnelle…"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"
                            android:padding="14dp"
                            android:textColor="@color/text_main"
                            android:textColorHint="@color/text_soft"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:drawableStart="@drawable/ic_lock"
                            android:drawablePadding="6dp"
                            android:drawableTint="@color/text_soft"
                            android:gravity="center_vertical"
                            android:text="Visible uniquement par toi"
                            android:textColor="@color/text_soft"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Suivre les sorties -->
                    <LinearLayout
                        style="@style/DetailCard"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bell"
                            android:tint="@color/text_main" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Suivre les prochaines sorties"
                                android:textColor="@color/text_main"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/dFollowSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_soft"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/dFollowSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ═════════ Onglet : Détails ═════════ -->
                <LinearLayout
                    android:id="@+id/tabDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginTop="18dp"
                        android:text="À propos de la série"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:id="@+id/dInfoCard"
                        style="@style/DetailCard"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:id="@+id/dInfos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dGenresTitle"
                        style="@style/SectionTitle"
                        android:layout_marginTop="20dp"
                        android:text="Genres"
                        android:textSize="18sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/dGenres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/dCreditsTitle"
                        style="@style/SectionTitle"
                        android:layout_marginTop="18dp"
                        android:text="Crédits"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:id="@+id/dCredits"
                        style="@style/DetailCard"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dAniList"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:text="Voir sur AniList"
                        android:textColor="@color/brand"
                        android:visibility="gone"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_open"
                        app:iconGravity="textStart"
                        app:iconTint="@color/brand"
                        app:strokeColor="@color/brand" />

                    <LinearLayout
                        android:id="@+id/dAltCard"
                        style="@style/DetailCard"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/dAltHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/CardTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="Titres alternatifs"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/dAltIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_expand"
                                android:tint="@color/text_main" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dAltList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/text_soft"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barre du haut : transparente sur le hero, opaque (miniature + titre) une fois défilée -->
    <LinearLayout
        android:id="@+id/dTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/dBack"
            style="@style/TopBarButton"
            android:contentDescription="Retour"
            android:src="@drawable/ic_back" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/dBarThumb"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="12dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedSmall" />

        <TextView
            android:id="@+id/dBarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:alpha="0"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/dMore"
            style="@style/TopBarButton"
            android:contentDescription="Plus d'actions"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- Bouton Reprendre collant (apparaît quand celui du hero n'est plus visible) -->
    <FrameLayout
        android:id="@+id/dSticky"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sticky"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dStickyResume"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Reprendre la lecture"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconTint="@color/on_accent" />
    </FrameLayout>
</FrameLayout>
