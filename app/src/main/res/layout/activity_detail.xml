<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- ───────── En-tête : couverture floutée ───────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="270dp">

                <ImageView
                    android:id="@+id/dHeaderBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/brand_dark"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_detail_fade" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/dContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-120dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <!-- Affiche + titre -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="124dp"
                        android:background="@drawable/bg_card"
                        android:elevation="14dp"
                        android:outlineAmbientShadowColor="@color/shadow_strong"
                        android:outlineSpotShadowColor="@color/shadow_strong">

                        <TextView
                            android:id="@+id/dAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="44sp" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/dCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/RoundedCover" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/dMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/brand"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="-0.02"
                            android:maxLines="3"
                            android:textColor="@color/text_main"
                            android:textSize="23sp" />

                        <TextView
                            android:id="@+id/dAlt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/text_soft"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/dTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:chipSpacingVertical="0dp" />

                <!-- Reprendre + cloche -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dResume"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:outlineAmbientShadowColor="#99FFB020"
                        android:outlineSpotShadowColor="#99FFB020"
                        android:text="▶  Reprendre la lecture"
                        android:textColor="@color/on_accent"
                        android:textSize="15sp"
                        app:backgroundTint="@color/accent"
                        app:cornerRadius="18dp"
                        app:elevation="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dBell"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="Alertes nouveaux chapitres"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_bell"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="26dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dBellHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_soft"
                    android:textSize="12sp" />

                <!-- Progression -->
                <LinearLayout style="@style/DetailCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Progression" />

                        <TextView
                            android:id="@+id/dProgValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/text_main"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/dProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="1000"
                        app:indicatorColor="@color/accent"
                        app:trackColor="@color/chart_grid"
                        app:trackCornerRadius="99dp"
                        app:trackThickness="10dp" />

                    <TextView
                        android:id="@+id/dProgSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_soft"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Où lire la suite -->
                <LinearLayout
                    android:id="@+id/dWhereCard"
                    style="@style/DetailCard"
                    android:visibility="gone">

                    <TextView
                        style="@style/CardTitle"
                        android:text="🔔 Où lire la suite" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/dWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Résumé -->
                <LinearLayout style="@style/DetailCard">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Résumé" />

                    <TextView
                        android:id="@+id/dSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="6"
                        android:text="Chargement du résumé…"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/dSummaryMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Lire la suite"
                        android:textColor="@color/brand"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/dSummarySrc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_soft"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Infos -->
                <LinearLayout
                    android:id="@+id/dInfoCard"
                    style="@style/DetailCard"
                    android:visibility="gone">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Infos" />

                    <LinearLayout
                        android:id="@+id/dInfos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dAniList"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-12dp"
                        android:text="Voir la fiche complète  ↗"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Mon avis -->
                <LinearLayout style="@style/DetailCard">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Mon avis" />

                    <LinearLayout
                        android:id="@+id/dStars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />

                    <EditText
                        android:id="@+id/dNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search"
                        android:gravity="top"
                        android:hint="Ce que j'en pense, où j'en suis, à quoi faire attention…"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="@color/text_main"
                        android:textColorHint="@color/text_soft"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Mes stats -->
                <LinearLayout style="@style/DetailCard">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Mes stats sur cette série" />

                    <LinearLayout
                        android:id="@+id/dStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Recommandations -->
                <TextView
                    android:id="@+id/dRecoTitle"
                    style="@style/SectionTitle"
                    android:layout_marginTop="20dp"
                    android:text="Si tu aimes cette série"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/dRecoScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-20dp"
                    android:layout_marginEnd="-20dp"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/dRecos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />
                </HorizontalScrollView>

                <!-- Historique -->
                <LinearLayout
                    style="@style/DetailCard"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="4dp">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Historique" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dAdd"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="＋ Ajouter" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:text="Touche un chapitre pour le retirer"
                        android:textColor="@color/text_soft"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/dHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/dHistoryMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="24dp"
                        android:paddingTop="8dp"
                        android:textColor="@color/brand"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barre du haut flottante -->
    <LinearLayout
        android:id="@+id/dTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/dBack"
            style="@style/TopBarButton"
            android:contentDescription="Retour"
            android:src="@drawable/ic_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/dMore"
            style="@style/TopBarButton"
            android:contentDescription="Plus d'actions"
            android:src="@drawable/ic_more" />
    </LinearLayout>
</FrameLayout>
