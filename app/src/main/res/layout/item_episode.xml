<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne de la liste d'épisodes (design inspiré de l'appli WEBTOON) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/eRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="20dp"
    android:paddingTop="7dp"
    android:paddingEnd="20dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/eContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_resume_thumb_glow"
            android:padding="1dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/eThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedThumb" />

            <!-- Payant : voile + cadenas sur la vignette -->
            <FrameLayout
                android:id="@+id/eLock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_thumb_scrim"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    android:tint="#E6FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/eNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_bold"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/eBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="5dp"
                android:max="100"
                android:visibility="gone"
                app:indicatorColor="@color/accent"
                app:trackColor="#66FFFFFF"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/eName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_bold"
                    android:maxLines="1"
                    android:textColor="@color/text_main"
                    android:textSize="15.5sp" />

                <!-- Pastille d'état : NOUVEAU, PAYANT, GRATUIT, EN COURS (couleurs posées dans le code) -->
                <TextView
                    android:id="@+id/eBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tag_small"
                    android:fontFamily="@font/inter_bold"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/online"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/eDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/eExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:textColor="@color/online"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- « Aussi en 🇪🇸 🇰🇷 » : éditions officielles où ce chapitre existe -->
            <TextView
                android:id="@+id/eAlso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_soft"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:paddingStart="9dp"
                android:paddingTop="2dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:textColor="@color/badge_text"
                android:textSize="12.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/eBtn"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_episode_btn"
            android:gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:minWidth="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Relire"
            android:textColor="@color/badge_text"
            android:textSize="14.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/eFold"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-7dp"
        android:layout_marginEnd="-20dp"
        android:contentDescription="@null"
        android:src="@drawable/episode_fold"
        android:visibility="gone" />
</FrameLayout>
