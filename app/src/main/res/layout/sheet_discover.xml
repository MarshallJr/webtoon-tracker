<?xml version="1.0" encoding="utf-8"?>
<!-- Fiche d'une série de « Découvrir » : note, genres, résumé, où la lire officiellement, ma liste -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/dsCover"
                android:layout_width="104dp"
                android:layout_height="150dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedGrid" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_bold"
                    android:maxLines="3"
                    android:textColor="@color/text_main"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/dsAlt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_soft"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dsScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_tag_small"
                        android:fontFamily="@font/inter_bold"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/dsType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_tag_small"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/badge_text"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/dsStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_small"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/badge_text"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dsFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_soft"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/dsBecause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawableStart="@drawable/ic_star"
            android:drawablePadding="8dp"
            android:drawableTint="@color/brand"
            android:gravity="center_vertical"
            android:textColor="@color/badge_text"
            android:textSize="13.5sp"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/dsGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_bold"
            android:text="Résumé"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/dsLoading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/brand" />

        <TextView
            android:id="@+id/dsDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="7"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dsMore"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center_vertical"
            android:text="Lire la suite"
            android:textColor="@color/brand"
            android:textSize="13.5sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter_bold"
            android:text="Où la lire"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/dsLinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="6dp" />

        <TextView
            android:id="@+id/dsNoLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Aucune plateforme officielle connue pour l'instant."
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dsWish"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="15sp"
                app:cornerRadius="26dp"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dsAnilist"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/inter_semibold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="AniList"
                android:textColor="@color/badge_text"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_outward"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/badge_text"
                app:strokeColor="@color/hairline_strong" />
        </LinearLayout>

        <TextView
            android:id="@+id/dsCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Données : AniList"
            android:textColor="@color/text_soft"
            android:textSize="11.5sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
